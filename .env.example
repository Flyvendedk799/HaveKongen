# Havekongen — front-end environment.
#
# Copy to .env and fill in your Supabase project. Everything here is shipped to
# the browser, so nothing secret belongs in this file: the anon key is meant to
# be public, and row level security is what protects the data behind it.
#
# Secrets used by the edge functions are set on the project instead:
#   supabase secrets set OPENAI_API_KEY=…
# See README.md for the full list and what happens when each one is missing.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
